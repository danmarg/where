<configuration>
    <!--
        Without this file logback defaults to DEBUG on the root logger, which makes Netty and
        the AWS SDK log verbosely (potentially including request details). Keep INFO for our
        own logs and the redacted request log, and quiet third-party libraries.
    -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="software.amazon" level="WARN"/>
    <logger name="org.apache.http" level="WARN"/>
    <logger name="org.apache.http.wire" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
