CREATE TABLE Outbox (
    msgId TEXT NOT NULL PRIMARY KEY,
    friendId TEXT NOT NULL,
    token TEXT NOT NULL,
    payloadBlob BLOB NOT NULL,
    createdAt INTEGER NOT NULL
);

-- Outbox Queries
-- Plain INSERT: a repeated msgId fails the transaction instead of replacing the row, which would
-- move the frame to the back of the queue (a new rowid) or overwrite one not yet posted.
insertOutbox:
INSERT INTO Outbox(msgId, friendId, token, payloadBlob, createdAt)
VALUES (?, ?, ?, ?, ?);

deleteOutboxByMsgId:
DELETE FROM Outbox WHERE msgId = ?;

deleteOutboxByMsgIdAndFriendId:
DELETE FROM Outbox WHERE msgId = ? AND friendId = ?;

deleteOutboxByFriendId:
DELETE FROM Outbox WHERE friendId = ?;

deleteOutboxByFriendIdAndToken:
DELETE FROM Outbox WHERE friendId = ? AND token = ?;

getOutboxForFriend:
-- Queue order (rowid grows with each insert), not createdAt: the wall clock can step back, and
-- the transition rule needs strict FIFO (§5.4.1, §5.4.3; OutboxOrderTest).
SELECT * FROM Outbox WHERE friendId = ? ORDER BY rowid ASC;

-- Rows left behind by a removed friend (see E2eeManager.deleteFriendKeepingOutbox): delivery
-- needs only the token and the already-encrypted payload, not the session.
getOrphanedOutbox:
SELECT * FROM Outbox WHERE friendId NOT IN (SELECT id FROM Friends) ORDER BY rowid ASC;

-- Cleanup
deleteAll:
DELETE FROM Outbox;
