CREATE TABLE Outbox (
    msgId TEXT NOT NULL PRIMARY KEY,
    friendId TEXT NOT NULL,
    token TEXT NOT NULL,
    payloadBlob BLOB NOT NULL,
    createdAt INTEGER NOT NULL
);

-- Outbox Queries
insertOutbox:
INSERT OR REPLACE INTO Outbox(msgId, friendId, token, payloadBlob, createdAt)
VALUES (?, ?, ?, ?, ?);

deleteOutboxByMsgId:
DELETE FROM Outbox WHERE msgId = ?;

deleteOutboxByMsgIdAndFriendId:
DELETE FROM Outbox WHERE msgId = ? AND friendId = ?;

deleteOutboxByFriendId:
DELETE FROM Outbox WHERE friendId = ?;

deleteOutboxByFriendIdAndToken:
DELETE FROM Outbox WHERE friendId = ? AND token = ?;

getOutboxForFriend:
SELECT * FROM Outbox WHERE friendId = ? ORDER BY createdAt ASC;

-- Rows left behind by a removed friend (see E2eeManager.deleteFriendKeepingOutbox): delivery
-- needs only the token and the already-encrypted payload, not the session.
getOrphanedOutbox:
SELECT * FROM Outbox WHERE friendId NOT IN (SELECT id FROM Friends) ORDER BY createdAt ASC;

deleteOrphanedOutboxCreatedBefore:
DELETE FROM Outbox WHERE friendId NOT IN (SELECT id FROM Friends) AND createdAt < ?;

-- Cleanup
deleteAll:
DELETE FROM Outbox;
