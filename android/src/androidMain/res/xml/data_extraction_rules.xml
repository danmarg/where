<?xml version="1.0" encoding="utf-8"?>
<!--
    Exclude ALL app data from cloud backup and device-to-device transfer (Android 12+).

    android:allowBackup="false" alone does not stop device-to-device migration for apps
    targeting API 31+. The SQLite database holds live Double Ratchet session state; a cloned
    or restored copy rolls back send counters and reuses (key, nonce) pairs, leaking the XOR
    of location plaintexts to the server. Sessions must never leave the device (spec §5.5).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
