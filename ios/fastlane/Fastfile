default_platform(:ios)

opt_out_usage
skip_docs

# All signing assets and the App Store Connect API key live here (gitignored).
SIGNING_DIR     = File.expand_path("signing", __dir__)
KEYCHAIN_NAME   = "where-fastlane.keychain-db"
KEYCHAIN_PASS   = ENV["FASTLANE_KEYCHAIN_PASSWORD"] || "where-fastlane"
PROFILE_NAME    = "Where AppStore"
SCHEME          = "Where"
BUNDLE_ID       = "net.af0.WhereApp"
TEAM_ID         = "5PM2V9LTHC"
REPO_ROOT       = File.expand_path("../..", __dir__)

# App Store Connect API key file. Create one at
# https://appstoreconnect.apple.com/access/integrations/api and drop the
# downloaded AuthKey_XXXXXXXXXX.p8 into ios/fastlane/signing/.
# Set FASTLANE_ASC_KEY_ID and FASTLANE_ASC_ISSUER_ID in your shell (or .envrc).
def asc_api_key
  key_id    = ENV.fetch("FASTLANE_ASC_KEY_ID")
  issuer_id = ENV.fetch("FASTLANE_ASC_ISSUER_ID")
  key_path  = Dir[File.join(SIGNING_DIR, "AuthKey_*.p8")].first
  UI.user_error!("No AuthKey_*.p8 found in #{SIGNING_DIR}") unless key_path
  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_path,
    in_house: false,
  )
end

platform :ios do
  desc "One-time: create Distribution certificate + App Store provisioning profile and store them locally"
  lane :bootstrap_signing do
    FileUtils.mkdir_p(SIGNING_DIR)
    api_key = asc_api_key

    # Distribution certificate -> .cer + .p12 written into SIGNING_DIR.
    get_certificates(
      development: false,
      output_path: SIGNING_DIR,
      api_key: api_key,
      generate_apple_certs: true,
    )

    # App Store provisioning profile -> .mobileprovision written into SIGNING_DIR.
    get_provisioning_profile(
      app_identifier: BUNDLE_ID,
      api_key: api_key,
      output_path: SIGNING_DIR,
      provisioning_name: PROFILE_NAME,
      filename: "WhereAppStore.mobileprovision",
      force: true,
    )

    UI.success("Signing assets written to #{SIGNING_DIR}")
    UI.important("Back this directory up somewhere safe — it holds your private signing key.")
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    prepare_signing
    build_number = next_build_number(api_key: api_key)
    generate_project
    build_shared_framework
    build_release_ipa(build_number: build_number)
    upload_to_testflight(
      api_key: api_key,
      changelog: release_notes,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build and upload to App Store (for review)"
  lane :release do
    api_key = asc_api_key
    prepare_signing
    build_number = next_build_number(api_key: api_key)
    generate_project
    build_shared_framework
    build_release_ipa(build_number: build_number)
    upload_to_app_store(
      api_key: api_key,
      # Not skip_metadata: true - this uploads fastlane/metadata/en-US/release_notes.txt (the
      # only metadata file present). deliver only pushes fields it finds a file for and leaves
      # everything else (name, description, keywords, ...) - still managed manually in App
      # Store Connect - untouched; see deliver's upload_metadata.rb load_from_filesystem.
      skip_screenshots: true,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )
  end

  # --- helpers -------------------------------------------------------------

  # "What's new" text for the release currently being deployed - edit this file before running
  # `beta` or `release`. deliver (used by `release`) reads it from the same metadata directory
  # directly; pilot (used by `beta`) has no file-based convention of its own, so read it here
  # and pass it through explicitly.
  private_lane :release_notes do
    path = File.expand_path("metadata/en-US/release_notes.txt", __dir__)
    UI.user_error!("No release notes at #{path}") unless File.exist?(path)
    File.read(path).strip
  end

  # One above the latest build App Store Connect has (or project.yml's, if higher), passed to
  # the archive as a build setting rather than written to project.yml. Bumping a checked-in
  # number let an upload come out lower than one already on TestFlight whenever the bump hadn't
  # been committed, and left every deploy with an uncommitted change. "Latest" is the most
  # recently uploaded build, which this lane always numbers above everything before it.
  private_lane :next_build_number do |options|
    project_yml = File.read(File.join(REPO_ROOT, "ios/project.yml"))
    checked_in = project_yml[/^\s*CURRENT_PROJECT_VERSION:\s*(\d+)/, 1]
    UI.user_error!("Couldn't find CURRENT_PROJECT_VERSION in ios/project.yml") unless checked_in
    checked_in = checked_in.to_i
    uploaded = latest_testflight_build_number(
      api_key: options[:api_key],
      app_identifier: BUNDLE_ID,
      initial_build_number: 0,
    ).to_i
    number = [checked_in, uploaded].max + 1
    UI.success("Build number #{number} (App Store Connect: #{uploaded}, project.yml: #{checked_in})")
    number
  end

  private_lane :generate_project do
    ios_dir = File.join(REPO_ROOT, "ios")
    sh("xcodegen generate --spec \"#{ios_dir}/project.yml\" --project \"#{ios_dir}\"")
  end

  # Rebuilds the Release XCFramework from scratch so the archive can't link a stale one (a
  # TestFlight build once shipped an old Shared framework). Xcode's pre-build script builds it
  # too, but only as an incremental Gradle run.
  private_lane :build_shared_framework do
    started = Time.now
    xcframework = File.join(REPO_ROOT, "shared/build/XCFrameworks/release/Shared.xcframework")
    FileUtils.rm_rf(File.join(REPO_ROOT, "shared/build/XCFrameworks"))
    sh("cd \"#{REPO_ROOT}\" && ./gradlew :shared:assembleSharedReleaseXCFramework")
    unless File.directory?(xcframework) && File.mtime(xcframework) >= started
      UI.user_error!("#{xcframework} wasn't rebuilt")
    end
  end

  private_lane :prepare_signing do
    p12 = Dir[File.join(SIGNING_DIR, "*.p12")].first
    profile = Dir[File.join(SIGNING_DIR, "*.mobileprovision")].first
    UI.user_error!("No .p12 in #{SIGNING_DIR} — run `fastlane bootstrap_signing` first.") unless p12
    UI.user_error!("No .mobileprovision in #{SIGNING_DIR} — run `fastlane bootstrap_signing` first.") unless profile

    create_keychain(
      name: KEYCHAIN_NAME,
      password: KEYCHAIN_PASS,
      default_keychain: false,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
    )

    import_certificate(
      certificate_path: p12,
      certificate_password: ENV["FASTLANE_P12_PASSWORD"] || "",
      keychain_name: KEYCHAIN_NAME,
      keychain_password: KEYCHAIN_PASS,
    )

    install_provisioning_profile(path: profile)

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Where.xcodeproj",
      targets: ["Where"],
      build_configurations: ["Release"],
      team_id: TEAM_ID,
      bundle_identifier: BUNDLE_ID,
      profile_name: lane_context[SharedValues::SIGH_NAME] || PROFILE_NAME,
      code_sign_identity: "Apple Distribution",
    )
  end

  private_lane :build_release_ipa do |options|
    build_app(
      project: "Where.xcodeproj",
      scheme: SCHEME,
      configuration: "Release",
      xcargs: "CURRENT_PROJECT_VERSION=#{options[:build_number]}",
      export_method: "app-store",
      output_directory: "build/fastlane",
      clean: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => (lane_context[SharedValues::SIGH_NAME] || PROFILE_NAME),
        },
      },
    )
  end

  after_all do
    delete_keychain(name: KEYCHAIN_NAME) if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}"))
  end

  error do
    delete_keychain(name: KEYCHAIN_NAME) if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN_NAME}"))
  end
end
